+++ b/modules/nexus-ai/apps/tests/test_neuralops_gate.py
@@ -0,0 +1,140 @@
+"""
+NeuralOps on top of tool approvals (apps/managers/neuralops_gate.py): policies
+with a named approver win over a tool's level, standing approvals let
+unattended runs act, every acting call is recorded, and a frozen workspace
+stops everything. The guard is faked here; the NeuralOps repo runs the same
+gate against a live core (tests/nexus-gate.test.ts).
+"""
+from types import SimpleNamespace
+
+import pytest
+from pydantic_ai.exceptions import SkipToolExecution
+
+from apps.managers.approvals import ApprovalOutcome
+from apps.managers.neuralops_gate import NeuralOpsToolGate, persona_identity
+from apps.managers.neuralops_guard import Decision
+
+CTX = SimpleNamespace(tool_call_approved=False)
+
+
+def tool_def(name, capability_id, metadata=None):
+    return SimpleNamespace(name=name, capability_id=capability_id, metadata=metadata or {})
+
+
+def call(name, call_id="c1"):
+    return SimpleNamespace(tool_name=name, tool_call_id=call_id)
+
+
+class FakeGuard:
+    """What the NeuralOps core would answer, and what it was told."""
+
+    fail_open = False
+
+    def __init__(self, policy=None, performs=(), decision=("approved", {})):
+        self.policy_answer = policy or {"governed": False, "authority": False, "frozen": False}
+        self.performs = list(performs)
+        self.decision = decision
+        self.checked, self.blocks = [], []
+
+    async def apolicy(self, tool, **kw):
+        return self.policy_answer
+
+    async def acheck(self, tool, args=None, **kw):
+        self.checked.append(tool)
+        return self.performs.pop(0) if self.performs else Decision(True, "ok", via="ungoverned")
+
+    async def await_decision(self, approval_id, *, timeout, poll=1.0):
+        return self.decision
+
+    async def areport_block(self, tool, reason, **kw):
+        self.blocks.append((tool, reason))
+
+
+class Asker:
+    def __init__(self, *outcomes):
+        self.outcomes, self.asked = list(outcomes), []
+
+    async def __call__(self, request):
+        self.asked.append(request)
+        return self.outcomes.pop(0)
+
+
+GOVERNED = {"governed": True, "authority": False, "frozen": False}
+PENDING = Decision(False, "needs approval", approval_id="approval_0007", approver="human.noaman")
+
+
+def test_persona_identity_is_stable_and_safe():
+    assert persona_identity("7f3a-B9") == "agent.persona-7f3a-b9"
+    assert persona_identity("../x y") == "agent.persona-x-y"
+
+
+@pytest.mark.asyncio
+async def test_without_a_guard_it_is_exactly_the_tool_approval_gate():
+    gate = NeuralOpsToolGate(levels={}, ask=Asker(ApprovalOutcome("allow")))
+    assert await gate.before_tool_execute(CTX, call=call("run_command"), tool_def=tool_def("run_command", "shell"), args={}) == {}
+
+
+@pytest.mark.asyncio
+async def test_a_governed_tool_waits_for_the_named_approver_even_at_level_auto():
+    guard = FakeGuard(GOVERNED, performs=[PENDING, Decision(True, "ok", via="approval")])
+    asker = Asker()
+    gate = NeuralOpsToolGate(levels={"mcp:odoo": "auto"}, ask=asker, interactive=True, guard=guard)
+    args = {"partner": "ACME"}
+    assert await gate.before_tool_execute(CTX, call=call("create_invoice"), tool_def=tool_def("create_invoice", "mcp:odoo"), args=args) is args
+    assert asker.asked == []  # the topic was not asked: the policy's approver decided
+    assert guard.checked == ["create_invoice", "create_invoice"]
+
+
+@pytest.mark.asyncio
+async def test_a_denial_by_the_approver_skips_the_call_with_their_reason():
+    guard = FakeGuard(GOVERNED, performs=[PENDING], decision=("denied", {"reason": "wrong customer"}))
+    gate = NeuralOpsToolGate(levels={}, ask=Asker(), interactive=True, guard=guard)
+    with pytest.raises(SkipToolExecution) as skipped:
+        await gate.before_tool_execute(CTX, call=call("create_invoice"), tool_def=tool_def("create_invoice", "mcp:odoo"), args={})
+    assert "human.noaman declined create_invoice (wrong customer)" in skipped.value.result
+
+
+@pytest.mark.asyncio
+async def test_an_unattended_run_uses_a_standing_approval():
+    guard = FakeGuard(GOVERNED, performs=[Decision(True, "ok", via="approval")])
+    gate = NeuralOpsToolGate(levels={}, ask=Asker(), interactive=False, guard=guard)
+    assert await gate.before_tool_execute(CTX, call=call("create_invoice"), tool_def=tool_def("create_invoice", "mcp:odoo"), args={}) == {}
+
+
+@pytest.mark.asyncio
+async def test_an_unattended_run_without_one_leaves_the_request_and_moves_on():
+    guard = FakeGuard(GOVERNED, performs=[PENDING])
+    gate = NeuralOpsToolGate(levels={}, ask=Asker(), interactive=False, guard=guard)
+    with pytest.raises(SkipToolExecution) as skipped:
+        await gate.before_tool_execute(CTX, call=call("create_invoice"), tool_def=tool_def("create_invoice", "mcp:odoo"), args={})
+    assert "approval_0007 from human.noaman" in skipped.value.result
+
+
+@pytest.mark.asyncio
+async def test_ungoverned_tools_keep_nexus_levels_and_are_recorded():
+    guard = FakeGuard()
+    asker = Asker(ApprovalOutcome("allow"))
+    gate = NeuralOpsToolGate(levels={}, ask=asker, interactive=True, guard=guard)
+    await gate.before_tool_execute(CTX, call=call("run_command"), tool_def=tool_def("run_command", "shell"), args={"command": "ls"})
+    assert len(asker.asked) == 1           # Nexus' own Ask still happens
+    assert guard.checked == ["run_command"]  # and the call is recorded
+    await gate.before_tool_execute(CTX, call=call("read_file", "c2"), tool_def=tool_def("read_file", "filesystem"), args={})
+    assert guard.checked == ["run_command"]  # reads are not recorded
+
+
+@pytest.mark.asyncio
+async def test_a_topic_denial_is_recorded_as_a_block():
+    guard = FakeGuard()
+    gate = NeuralOpsToolGate(levels={}, ask=Asker(ApprovalOutcome("deny")), interactive=True, guard=guard)
+    with pytest.raises(SkipToolExecution):
+        await gate.before_tool_execute(CTX, call=call("run_command"), tool_def=tool_def("run_command", "shell"), args={})
+    assert guard.blocks and guard.blocks[0][0] == "run_command"
+
+
+@pytest.mark.asyncio
+async def test_a_frozen_workspace_stops_every_tool():
+    guard = FakeGuard({"governed": False, "authority": False, "frozen": True})
+    gate = NeuralOpsToolGate(levels={"shell": "auto"}, ask=Asker(), interactive=True, guard=guard)
+    with pytest.raises(SkipToolExecution) as skipped:
+        await gate.before_tool_execute(CTX, call=call("run_command"), tool_def=tool_def("run_command", "shell"), args={})
+    assert "frozen" in skipped.value.result
